---
---
<style>
    @keyframes float-glow {
        0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.3; }
        50% { transform: translate(-50%, -55%) scale(1.1); opacity: 0.5; }
    }
    @keyframes fade-in-up {
        0% { opacity: 0; transform: translateY(40px); }
        100% { opacity: 1; transform: translateY(0); }
    }
    .animate-glow {
        animation: float-glow 8s ease-in-out infinite;
    }
    .animate-entry {
        opacity: 0;
        animation: fade-in-up 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .delay-100 { animation-delay: 100ms; }
    .delay-300 { animation-delay: 300ms; }
    .delay-500 { animation-delay: 500ms; }
</style>

<section class="relative min-h-[100dvh] flex flex-col justify-center px-6 lg:px-12 bg-slate-950 overflow-hidden pt-24 pb-12">
    
    <div class="absolute top-1/2 left-1/2 w-[300px] md:w-[700px] h-[300px] md:h-[700px] bg-slate-700/30 rounded-full blur-[120px] pointer-events-none z-0 animate-glow"></div>

    <div class="absolute inset-0 z-0 opacity-40">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:4rem_4rem] md:bg-[size:5rem_5rem]"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-transparent to-slate-950"></div>
    </div>

    <div class="max-w-7xl mx-auto w-full relative z-10">
        
        <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full border border-slate-700 bg-slate-900/80 backdrop-blur-md mb-8 md:mb-12 shadow-2xl animate-entry delay-100">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-300 animate-pulse"></span>
            <span class="text-slate-200 tracking-[0.25em] uppercase text-[9px] font-bold">
                Firma Legal Especializada
            </span>
        </div>
        
        <!-- FIX APLICADO ACÁ -->
        <h1 class="font-serif text-white mb-12 md:mb-16 animate-entry delay-300 flex flex-col">
            <span class="text-[5.5rem] leading-[1.1] md:text-8xl lg:text-[11rem] font-bold tracking-normal lg:tracking-tight lg:leading-[0.85] -ml-1 md:-ml-2">
                G.L.R.
            </span>
            <span class="text-5xl md:text-7xl lg:text-[8rem] font-light italic text-slate-400 leading-tight lg:leading-[0.85] mt-1 md:mt-4">
                Asociados.
            </span>
        </h1>
        
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-10 md:gap-16 border-t border-slate-800/80 pt-10 md:pt-12 animate-entry delay-500">
            
            <p class="text-slate-400 font-light text-sm md:text-base leading-relaxed max-w-xl border-l-2 border-slate-700 pl-4 md:pl-6">
                Protección legal estratégica en materia Civil, Laboral, Sucesiones, Familia y Penal. Jurisdicción en Provincia de Buenos Aires y CABA.
            </p>
            
            <a href="#contacto" class="group flex items-center gap-5 text-[10px] md:text-xs font-bold uppercase tracking-[0.2em] text-white hover:text-slate-300 transition-colors shrink-0 w-fit">
                <span>Conocer al equipo</span>
                <div class="w-14 h-14 rounded-full border border-slate-700 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center group-hover:bg-white group-hover:border-white transition-all duration-500 shadow-[0_0_20px_rgba(0,0,0,0.3)]">
                    <svg class="w-5 h-5 text-slate-300 group-hover:text-slate-950 transform group-hover:translate-x-1 transition-all duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                </div>
            </a>
        </div>
    </div>
</section>
---
const steps = [
    {
        number: "01",
        title: "Análisis Riguroso",
        description: "Evaluación profunda del escenario legal. Auditamos cada detalle del caso para identificar riesgos ocultos y oportunidades clave antes de dar el primer paso."
    },
    {
        number: "02",
        title: "Estrategia Ofensiva",
        description: "No reaccionamos, nos anticipamos. Diseñamos un plan de acción a medida con tácticas legales agresivas y efectivas para proteger sus intereses."
    },
    {
        number: "03",
        title: "Ejecución Implacable",
        description: "Llevamos la estrategia a la mesa de negociación o a los tribunales. Representación de altísimo nivel orientada exclusivamente a resultados."
    }
];
---
<section class="bg-slate-950 py-32 px-6 lg:px-12 border-b border-white/5 relative overflow-hidden">
    
    <!-- Textura de fondo sutil -->
    <div class="absolute inset-0 z-0 opacity-30">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:2rem_2rem]"></div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
        
        <div class="flex flex-col lg:flex-row gap-16 lg:gap-24">
            
            <!-- Columna Izquierda: Título -->
            <div class="lg:w-1/3 flex flex-col">
                <div class="flex items-center gap-4 mb-6">
                    <span class="w-10 h-[1px] bg-slate-600"></span>
                    <span class="text-slate-400 tracking-[0.25em] uppercase text-[9px] font-bold">
                        Metodología
                    </span>
                </div>
                <h2 class="text-4xl md:text-5xl font-serif text-white leading-tight mb-6">
                    El estándar <br/>
                    <span class="italic text-slate-500 font-light">G.L.R.</span>
                </h2>
                <p class="text-slate-400 text-sm font-light leading-relaxed">
                    Nuestra forma de ejercer el derecho no deja lugar a la improvisación. Un proceso estructurado diseñado para dominar cualquier escenario legal.
                </p>
            </div>

            <!-- Columna Derecha: Los 3 Pasos -->
            <div class="lg:w-2/3 flex flex-col">
                {steps.map((step, index) => (
                    <div class="group relative flex flex-col md:flex-row gap-6 md:gap-12 py-10 border-t border-slate-800/60 first:border-t-0 lg:first:pt-0 hover:border-slate-500 transition-colors duration-500">
                        
                        <!-- Glow de fondo en hover -->
                        <div class="absolute inset-0 bg-gradient-to-r from-slate-800/0 via-slate-800/10 to-slate-800/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"></div>

                        <div class="md:w-1/4">
                            <span class="text-5xl md:text-6xl font-serif font-light text-slate-800 group-hover:text-slate-500 transition-colors duration-500">
                                {step.number}
                            </span>
                        </div>
                        
                        <div class="md:w-3/4 flex flex-col justify-center">
                            <h3 class="text-xl md:text-2xl font-serif text-slate-200 mb-3 group-hover:text-white transition-colors duration-500">
                                {step.title}
                            </h3>
                            <p class="text-slate-500 text-sm md:text-base font-light leading-relaxed group-hover:text-slate-300 transition-colors duration-500">
                                {step.description}
                            </p>
                        </div>
                        
                    </div>
                ))}
            </div>

        </div>
    </div>
</section>
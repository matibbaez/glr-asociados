---
---
<footer class="relative bg-slate-950 border-t border-white/5 pt-24 pb-8 px-6 lg:px-12 overflow-hidden">
    
    <!-- Resplandor sutil de fondo -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[1px] bg-gradient-to-r from-transparent via-slate-700 to-transparent opacity-50"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[300px] bg-slate-900/30 rounded-full blur-[120px] pointer-events-none z-0"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        
        <!-- Grid Superior: 4 Columnas -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 mb-20">
            
            <!-- Columna 1: Marca y Descripción -->
            <div class="flex flex-col">
                <a href="#" class="flex flex-col mb-6">
                    <span class="text-white font-serif text-2xl lg:text-3xl font-bold tracking-widest leading-none">
                        G.L.R.
                    </span>
                    <span class="text-[7px] lg:text-[8px] font-sans tracking-[0.3em] text-slate-500 uppercase mt-1.5 font-bold">
                        Asociados
                    </span>
                </a>
                <p class="text-slate-400 font-light text-sm leading-relaxed pr-4">
                    Asistencia jurídica integral y estratégica. Especialistas en derecho Civil, Laboral, Sucesiones, Familia y Penal en PBA y CABA.
                </p>
            </div>

            <!-- Columna 2: Navegación -->
            <div class="flex flex-col">
                <h4 class="text-[10px] text-white uppercase tracking-[0.2em] font-bold mb-6">Explorar</h4>
                <nav class="flex flex-col gap-4">
                    <a href="#" class="text-sm text-slate-400 font-light hover:text-white transition-colors w-fit">Inicio</a>
                    <a href="#especialidades" class="text-sm text-slate-400 font-light hover:text-white transition-colors w-fit">Especialidades</a>
                    <a href="#contacto" class="text-sm text-slate-400 font-light hover:text-white transition-colors w-fit">Directorio de Socios</a>
                </nav>
            </div>

            <!-- Columna 3: Contacto (Datos simulados para la demo) -->
            <div class="flex flex-col">
                <h4 class="text-[10px] text-white uppercase tracking-[0.2em] font-bold mb-6">Sede Central</h4>
                <ul class="flex flex-col gap-4">
                    <li class="flex items-start gap-3 text-sm text-slate-400 font-light">
                        <svg class="w-4 h-4 text-slate-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span>Av. Corrientes 1234, Piso 5<br/>CABA, Argentina</span>
                    </li>
                    <li class="flex items-center gap-3 text-sm text-slate-400 font-light">
                        <svg class="w-4 h-4 text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                        <a href="mailto:estudio@glrasociados.com" class="hover:text-white transition-colors">estudio@glrasociados.com</a>
                    </li>
                </ul>
            </div>

            <!-- Columna 4: Horarios -->
            <div class="flex flex-col">
                <h4 class="text-[10px] text-white uppercase tracking-[0.2em] font-bold mb-6">Atención</h4>
                <ul class="flex flex-col gap-4 text-sm font-light">
                    <li class="flex justify-between text-slate-400 border-b border-slate-800/60 pb-2">
                        <span>Lunes a Viernes</span>
                        <span>09:00 - 18:00</span>
                    </li>
                    <li class="flex flex-col text-slate-400 pt-1">
                        <span class="text-white font-medium mb-1">Urgencias Penales</span>
                        <span class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400 animate-pulse"></span>
                            Asistencia 24 hs
                        </span>
                    </li>
                </ul>
            </div>
            
        </div>

        <!-- Barra Inferior: Copyright y Firma -->
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-8 border-t border-slate-800/60">
            <span class="text-[9px] md:text-[10px] text-slate-500 uppercase tracking-[0.2em] text-center md:text-left">
                © {new Date().getFullYear()} G.L.R. Asociados. Todos los derechos reservados.
            </span>
            
            <!-- Tu firma de agencia discreta y profesional -->
            <span class="text-[9px] md:text-[10px] text-slate-600 uppercase tracking-[0.2em]">
                Desarrollado por <a href="#" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white font-bold transition-colors">VisionPath</a>
            </span>
        </div>

    </div>
</footer>
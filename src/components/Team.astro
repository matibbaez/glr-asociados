---
const partners = [
    { 
        name: "Dr. Martín Greco", 
        role: "Socio Fundador", 
        link: "https://wa.link/l9x8ch",
        expertise: "Derecho Penal & Civil",
        // Imagen ficticia de Unsplash (abogado en traje)
        image: "https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=800&auto=format&fit=crop" 
    },
    { 
        name: "Dr. Leandro Lacaba", 
        role: "Socio Fundador", 
        link: "https://wa.link/ub4lcg",
        expertise: "Sucesiones & Laboral",
        image: "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&w=800&auto=format&fit=crop" 
    },
    { 
        name: "Dr. Edgardo Radesh", 
        role: "Socio Fundador", 
        link: "https://wa.link/n7b9sa",
        expertise: "Familia & Litigios",
        image: "https://images.unsplash.com/photo-1556157382-97eda2d62296?q=80&w=800&auto=format&fit=crop" 
    }
];
---
<section class="relative bg-slate-950 py-32 px-6 lg:px-12 overflow-hidden" id="contacto">
    
    <!-- Resplandor de fondo -->
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-slate-800/20 rounded-full blur-[150px] pointer-events-none z-0"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        
        <div class="mb-20">
            <div class="flex items-center gap-4 mb-6">
                <span class="w-10 h-[1px] bg-slate-600"></span>
                <span class="text-slate-400 tracking-[0.25em] uppercase text-[9px] font-bold">
                    Contacto Directo
                </span>
            </div>
            <h2 class="text-4xl md:text-6xl font-serif text-white leading-tight">
                Directorio de <br/>
                <span class="italic text-slate-500 font-light">Socios.</span>
            </h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            {partners.map((partner) => (
                <a 
                    href={partner.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="group relative flex flex-col p-8 md:p-10 bg-slate-900/40 border border-slate-800 hover:border-slate-500 transition-all duration-500 rounded-sm overflow-hidden"
                >
                    <div class="absolute inset-0 bg-gradient-to-br from-slate-800/0 via-slate-800/10 to-slate-700/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    <div class="absolute top-0 left-0 w-[3px] h-0 bg-white group-hover:h-full transition-all duration-700 ease-out"></div>
                    
                    <div class="relative z-10 flex flex-col h-full">
                        
                        <!-- Bloque de Foto Perfil -->
                        <div class="w-20 h-20 md:w-24 md:h-24 mb-8 overflow-hidden rounded-full border border-slate-700 group-hover:border-slate-400 transition-colors duration-500 shadow-xl shrink-0">
                            <img 
                                src={partner.image} 
                                alt={`Retrato de ${partner.name}`}
                                class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700 ease-out"
                                loading="lazy"
                            />
                        </div>

                        <div class="mb-12">
                            <span class="block text-[9px] uppercase tracking-[0.25em] text-slate-500 font-bold mb-4">
                                {partner.role}
                            </span>
                            <h3 class="text-white font-serif text-2xl md:text-3xl mb-2">
                                {partner.name}
                            </h3>
                            <span class="text-slate-400 font-light text-sm">
                                {partner.expertise}
                            </span>
                        </div>
                        
                        <div class="mt-auto flex items-center justify-between border-t border-slate-800/60 pt-6 group-hover:border-slate-500 transition-colors duration-500">
                            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400 group-hover:text-white transition-colors">
                                Iniciar Consulta
                            </span>
                            
                            <div class="w-10 h-10 rounded-full border border-slate-700 flex items-center justify-center group-hover:bg-white group-hover:border-white transition-all duration-500 shrink-0 shadow-lg">
                                <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-950 transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                </svg>
                            </div>
                        </div>
                    </div>
                </a>
            ))}
        </div>
        
    </div>
</section>